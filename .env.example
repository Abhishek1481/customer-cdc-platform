# Copy to .env and replace every "change-me" value. .env is git-ignored.

# --- Source PostgreSQL (docker-compose creates it) ---------------------------
POSTGRES_DB=customers_db
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
# Used by cdc-workload when run from the host (outside Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Least-privilege replication login used by Debezium
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=change-me

# --- Kafka / consumer --------------------------------------------------------
# From the host use localhost:9092; containers use kafka:29092 (set in compose)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083
KAFKA_GROUP_ID=customer-cdc-warehouse-loader
CONSUMER_BATCH_SIZE=500
CONSUMER_BATCH_TIMEOUT_SECONDS=5
SCD_INTERVAL_SECONDS=15
RETRY_MAX_ATTEMPTS=5

# --- Warehouse ---------------------------------------------------------------
# duckdb   = local development warehouse (no account needed)
# snowflake = real Snowflake; fill in the block below
WAREHOUSE_TARGET=duckdb
# DUCKDB_PATH=data/warehouse.duckdb

# --- Snowflake (only when WAREHOUSE_TARGET=snowflake) -------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=CDC_LOADER
SNOWFLAKE_WAREHOUSE=CDC_WH
SNOWFLAKE_DATABASE=CUSTOMER_CDC
# Preferred: key-pair auth. Put the key in ./secrets (git-ignored); inside the
# container it is mounted at /run/secrets/snowflake/<file>.
SNOWFLAKE_PRIVATE_KEY_DIR=./secrets
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Fallback: password auth
SNOWFLAKE_PASSWORD=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# json (default) or text
LOG_FORMAT=json
