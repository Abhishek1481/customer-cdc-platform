# Secrets - never commit
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
*.pem
*.p8
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Local data / generated artifacts
data/
*.duckdb
*.duckdb.wal
logs/
airflow-logs/
**/reports/*
!**/reports/.gitkeep

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Airflow CI virtualenv
.airflow-venv/
pytest-results.xml
